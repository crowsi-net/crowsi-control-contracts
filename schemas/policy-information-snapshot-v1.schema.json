{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crowsi://control/policy-information-snapshot/v1",
  "title": "Crowsi Signed Policy Information Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "snapshot_id",
    "identity_context_id",
    "pairwise_subject",
    "device_posture",
    "workload_posture",
    "incident",
    "management_authority",
    "authoritative_revocation_epoch",
    "risk_score",
    "coverage_assertion_id",
    "coverage_digest",
    "policy_digest",
    "issued_at",
    "expires_at",
    "signed"
  ],
  "properties": {
    "schema": { "const": "crowsi://control/policy-information-snapshot/v1" },
    "snapshot_id": { "$ref": "#/$defs/identifier" },
    "identity_context_id": { "$ref": "#/$defs/identifier" },
    "pairwise_subject": { "$ref": "#/$defs/opaque" },
    "device_posture": { "$ref": "#/$defs/posture" },
    "workload_posture": { "$ref": "#/$defs/posture" },
    "incident": { "$ref": "#/$defs/incident" },
    "management_authority": { "$ref": "#/$defs/authority" },
    "authoritative_revocation_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "risk_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "coverage_assertion_id": { "$ref": "#/$defs/identifier" },
    "coverage_digest": { "$ref": "#/$defs/digest" },
    "policy_digest": { "$ref": "#/$defs/digest" },
    "issued_at": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "signed": { "$ref": "#/$defs/signed" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{0,127}$"
    },
    "opaque": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "resource", "action", "purpose", "channel"],
      "properties": {
        "audience": { "$ref": "#/$defs/identifier" },
        "resource": { "$ref": "#/$defs/opaque" },
        "action": {
          "enum": ["quarantine", "restrict-egress", "revoke-access", "restore"]
        },
        "purpose": { "$ref": "#/$defs/identifier" },
        "channel": {
          "enum": ["hatter-interactive", "emergency-console", "service-automation"]
        }
      }
    },
    "posture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "state", "observed_at", "valid_until"],
      "properties": {
        "target": { "$ref": "#/$defs/opaque" },
        "state": { "enum": ["trusted", "untrusted", "unknown"] },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "valid_until": { "$ref": "#/$defs/timestamp" }
      }
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incident_id",
        "resource",
        "state",
        "observed_at",
        "valid_until"
      ],
      "properties": {
        "incident_id": { "$ref": "#/$defs/identifier" },
        "resource": { "$ref": "#/$defs/opaque" },
        "state": {
          "enum": [
            "normal",
            "detected",
            "containment-requested",
            "contained",
            "recovery-pending",
            "recovery-authorized",
            "restoring",
            "monitoring",
            "closed",
            "unknown"
          ]
        },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "valid_until": { "$ref": "#/$defs/timestamp" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "identity_context_id",
        "authorization_grant_id",
        "revocation_epoch",
        "binding",
        "observed_at",
        "valid_until"
      ],
      "properties": {
        "state": { "enum": ["authorized", "denied", "unknown"] },
        "identity_context_id": { "$ref": "#/$defs/identifier" },
        "authorization_grant_id": { "$ref": "#/$defs/opaque" },
        "revocation_epoch": { "type": "integer", "minimum": 0 },
        "binding": { "$ref": "#/$defs/binding" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "valid_until": { "$ref": "#/$defs/timestamp" }
      }
    },
    "signed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "digest", "signature"],
      "properties": {
        "algorithm": { "enum": ["ed25519", "ecdsa-p256-sha256"] },
        "key_id": { "$ref": "#/$defs/identifier" },
        "digest": { "$ref": "#/$defs/digest" },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43,2048}$"
        }
      }
    }
  }
}
