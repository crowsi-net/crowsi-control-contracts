{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crowsi://control/verified-identity-context/v1",
  "title": "Crowsi Verified Identity Context v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "context_id",
    "issuer",
    "pairwise_subject",
    "actor",
    "device",
    "workload",
    "profile",
    "proof_key_ref",
    "assurance",
    "authorization_grant_id",
    "revocation_epoch",
    "authenticated_at",
    "expires_at",
    "audience",
    "signed"
  ],
  "properties": {
    "schema": { "const": "crowsi://control/verified-identity-context/v1" },
    "context_id": { "$ref": "#/$defs/identifier" },
    "issuer": {
      "type": "string",
      "minLength": 9,
      "maxLength": 512,
      "pattern": "^https://"
    },
    "pairwise_subject": { "$ref": "#/$defs/opaque" },
    "actor": { "$ref": "#/$defs/opaque" },
    "device": { "$ref": "#/$defs/opaque" },
    "workload": { "$ref": "#/$defs/workload" },
    "profile": { "$ref": "#/$defs/opaque" },
    "proof_key_ref": { "$ref": "#/$defs/opaque" },
    "assurance": { "$ref": "#/$defs/assurance" },
    "authorization_grant_id": { "$ref": "#/$defs/opaque" },
    "revocation_epoch": { "type": "integer", "minimum": 0 },
    "authenticated_at": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "audience": { "$ref": "#/$defs/identifier" },
    "signed": { "$ref": "#/$defs/signed" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{0,127}$"
    },
    "opaque": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "workload": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^spiffe://[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*/[A-Za-z0-9_-][A-Za-z0-9._-]{0,63}(?:/[A-Za-z0-9_-][A-Za-z0-9._-]{0,63})*$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "assurance": {
      "enum": ["baseline", "phishing-resistant", "hardware-bound-step-up"]
    },
    "signed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "digest", "signature"],
      "properties": {
        "algorithm": { "enum": ["ed25519", "ecdsa-p256-sha256"] },
        "key_id": { "$ref": "#/$defs/identifier" },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43,2048}$"
        }
      }
    }
  }
}
