{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crowsi://control/coverage-assertion/v1",
  "title": "Crowsi Coverage Assertion v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assertion_id",
    "resource",
    "observer_id",
    "coverage",
    "freshness",
    "management",
    "verification",
    "health",
    "management_lifeline",
    "enforcement_readiness",
    "action_coverage",
    "observed_at",
    "valid_until",
    "evidence_digest",
    "signed"
  ],
  "properties": {
    "schema": { "const": "crowsi://control/coverage-assertion/v1" },
    "assertion_id": { "$ref": "#/$defs/identifier" },
    "resource": { "$ref": "#/$defs/opaque" },
    "observer_id": { "$ref": "#/$defs/identifier" },
    "coverage": { "enum": ["complete", "partial", "unknown"] },
    "freshness": { "enum": ["fresh", "stale"] },
    "management": { "enum": ["managed", "unmanaged"] },
    "verification": { "enum": ["verified", "unverified"] },
    "health": { "enum": ["healthy", "degraded", "unknown"] },
    "management_lifeline": {
      "enum": ["verified", "unverified", "absent"]
    },
    "enforcement_readiness": {
      "enum": ["ready", "degraded", "unavailable", "unknown"]
    },
    "action_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quarantine", "revoke", "verify", "restore"],
      "properties": {
        "quarantine": { "$ref": "#/$defs/capability" },
        "revoke": { "$ref": "#/$defs/capability" },
        "verify": { "$ref": "#/$defs/capability" },
        "restore": { "$ref": "#/$defs/capability" }
      }
    },
    "observed_at": { "$ref": "#/$defs/timestamp" },
    "valid_until": { "$ref": "#/$defs/timestamp" },
    "evidence_digest": { "$ref": "#/$defs/digest" },
    "signed": { "$ref": "#/$defs/signed" }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          { "properties": { "coverage": { "enum": ["partial", "unknown"] } } },
          { "properties": { "freshness": { "const": "stale" } } },
          { "properties": { "management": { "const": "unmanaged" } } }
        ]
      },
      "then": {
        "properties": {
          "verification": { "const": "unverified" },
          "health": { "enum": ["degraded", "unknown"] }
        }
      }
    },
    {
      "if": {
        "properties": { "verification": { "const": "unverified" } }
      },
      "then": {
        "properties": {
          "health": { "enum": ["degraded", "unknown"] }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{0,127}$"
    },
    "opaque": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "capability": {
      "enum": ["ready", "unavailable", "unknown"]
    },
    "signed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "digest", "signature"],
      "properties": {
        "algorithm": { "enum": ["ed25519", "ecdsa-p256-sha256"] },
        "key_id": { "$ref": "#/$defs/identifier" },
        "digest": { "$ref": "#/$defs/digest" },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43,2048}$"
        }
      }
    }
  }
}
