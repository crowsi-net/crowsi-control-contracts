{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crowsi://control/recovery-authorization/v1",
  "title": "Crowsi One-use Recovery Authorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authorization_id",
    "jti",
    "identity_context_id",
    "pairwise_subject",
    "binding",
    "incident_id",
    "policy_snapshot_id",
    "policy_snapshot_digest",
    "authoritative_revocation_epoch",
    "issued_at",
    "expires_at",
    "use_limit",
    "signed"
  ],
  "properties": {
    "schema": { "const": "crowsi://control/recovery-authorization/v1" },
    "authorization_id": { "$ref": "#/$defs/identifier" },
    "jti": { "$ref": "#/$defs/identifier" },
    "identity_context_id": { "$ref": "#/$defs/identifier" },
    "pairwise_subject": { "$ref": "#/$defs/opaque" },
    "binding": {
      "allOf": [
        { "$ref": "#/$defs/binding" },
        {
          "properties": {
            "action": { "const": "restore" }
          }
        }
      ]
    },
    "incident_id": { "$ref": "#/$defs/identifier" },
    "policy_snapshot_id": { "$ref": "#/$defs/identifier" },
    "policy_snapshot_digest": { "$ref": "#/$defs/digest" },
    "authoritative_revocation_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "issued_at": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "use_limit": { "const": 1 },
    "signed": { "$ref": "#/$defs/signed" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{0,127}$"
    },
    "opaque": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "resource", "action", "purpose", "channel"],
      "properties": {
        "audience": { "$ref": "#/$defs/identifier" },
        "resource": { "$ref": "#/$defs/opaque" },
        "action": { "const": "restore" },
        "purpose": { "$ref": "#/$defs/identifier" },
        "channel": {
          "enum": ["hatter-interactive", "emergency-console", "service-automation"]
        }
      }
    },
    "signed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "digest", "signature"],
      "properties": {
        "algorithm": { "enum": ["ed25519", "ecdsa-p256-sha256"] },
        "key_id": { "$ref": "#/$defs/identifier" },
        "digest": { "$ref": "#/$defs/digest" },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43,2048}$"
        }
      }
    }
  }
}
