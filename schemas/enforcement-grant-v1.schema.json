{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crowsi://control/enforcement-grant/v1",
  "title": "Crowsi One-use Enforcement Grant v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "grant_id",
    "jti",
    "decision_id",
    "intent_jti",
    "identity_context_id",
    "pairwise_subject",
    "actor",
    "device",
    "workload",
    "profile",
    "proof_key_ref",
    "revocation_epoch",
    "binding",
    "assurance",
    "issued_at",
    "expires_at",
    "use_limit",
    "policy_digest",
    "signed"
  ],
  "properties": {
    "schema": { "const": "crowsi://control/enforcement-grant/v1" },
    "grant_id": { "$ref": "#/$defs/identifier" },
    "jti": { "$ref": "#/$defs/identifier" },
    "decision_id": { "$ref": "#/$defs/identifier" },
    "intent_jti": { "$ref": "#/$defs/identifier" },
    "identity_context_id": { "$ref": "#/$defs/identifier" },
    "pairwise_subject": { "$ref": "#/$defs/opaque" },
    "actor": { "$ref": "#/$defs/opaque" },
    "device": { "$ref": "#/$defs/opaque" },
    "workload": { "$ref": "#/$defs/workload" },
    "profile": { "$ref": "#/$defs/opaque" },
    "proof_key_ref": { "$ref": "#/$defs/opaque" },
    "revocation_epoch": { "type": "integer", "minimum": 0 },
    "binding": { "$ref": "#/$defs/binding" },
    "assurance": {
      "enum": ["phishing-resistant", "hardware-bound-step-up"]
    },
    "issued_at": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "use_limit": { "const": 1 },
    "policy_digest": { "$ref": "#/$defs/digest" },
    "signed": { "$ref": "#/$defs/signed" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "binding": {
            "properties": { "action": { "const": "restore" } }
          }
        }
      },
      "then": {
        "properties": {
          "assurance": { "const": "hardware-bound-step-up" }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{0,127}$"
    },
    "opaque": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "workload": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^spiffe://[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*/[A-Za-z0-9_-][A-Za-z0-9._-]{0,63}(?:/[A-Za-z0-9_-][A-Za-z0-9._-]{0,63})*$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "resource", "action", "purpose", "channel"],
      "properties": {
        "audience": { "$ref": "#/$defs/identifier" },
        "resource": { "$ref": "#/$defs/opaque" },
        "action": {
          "enum": ["quarantine", "restrict-egress", "revoke-access", "restore"]
        },
        "purpose": { "$ref": "#/$defs/identifier" },
        "channel": {
          "enum": ["hatter-interactive", "emergency-console", "service-automation"]
        }
      }
    },
    "signed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "digest", "signature"],
      "properties": {
        "algorithm": { "enum": ["ed25519", "ecdsa-p256-sha256"] },
        "key_id": { "$ref": "#/$defs/identifier" },
        "digest": { "$ref": "#/$defs/digest" },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43,2048}$"
        }
      }
    }
  }
}
